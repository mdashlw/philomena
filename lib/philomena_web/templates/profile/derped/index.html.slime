h3 Top Added Tags
table.table
  thead
    tr
      th Tag
      th Times added
      th Rank among all users
  tbody
    = for %{tag: tag, count: count, rank: rank, ntile: ntile} <- @user_top_added_tags do
      tr
        td
          = render PhilomenaWeb.TagView, "_tag.html", tag: tag, conn: @conn
