      th Rank among all users
  tbody
    = for %{tag: tag, count: count, rank: rank, ntile: ntile} <- @user_top_removed_tags do
      tr
        td
          = render PhilomenaWeb.TagView, "_tag.html", tag: tag, conn: @conn
        td
          = number_with_delimiter(count)
        td
          = rank(rank, ntile)

h2 A Pony a Day
- daily_type = Keyword.get(scope, :daily)
p
  - what = if daily_type == "votes", do: "upvoted", else: "faved"
  ' A collection of random images you #{what} each day this year. Total
  => length(@user_random_daily_images)
  ' days.
  = if length(@user_random_daily_images) == 365 do
    | Wow - that's every single day!
  - else
    = if length(@user_random_daily_images) >= 360 do
      | Wow - that's almost every single day!
p
  - opposite_type = if daily_type == "votes", do: "faves", else: "votes"
  = link "Switch to #{opposite_type}", to: ~p"/profiles/#{@user}/derped?#{Keyword.put(scope, :daily, opposite_type)}"
.block
  .block__content.media-list.media-list--small
    = for {%{image: image, created_at: date}, index} <- Enum.with_index(@user_random_daily_images) do
      - style = if index == 0, do: "position: absolute;", else: ""
      .flex.flex--column style=style
        = render PhilomenaWeb.ImageView, "_image_box.html", image: image, size: :thumb_small, conn: @conn
        figcaption.center
          = Calendar.strftime(date, "%B %-d")

= if Enum.any?(@linked_tags) do
  h2 You as an Artist
  = for %{tag: tag, is_new: is_new, images: images, faves: faves, scores: scores, comments: comments, most_faved_images: most_faved_images, most_scored_images: most_scored_images, most_commented_on_images: most_commented_on_images} <- @linked_tags do
    = render PhilomenaWeb.TagView, "_tag.html", tag: tag, conn: @conn
    = if is_new do
      p Verified this year! Congrats!
      br
    p
      ' You created
      span.stat>
        = number_with_delimiter(images.new_count)
      ' images this year.
    = increase_stats(images.new_count, images.overall_count)
    br
    p
      ' You received a total of
      span.stat>
        = number_with_delimiter(faves.new_count)
      ' faves this year, of which
      => stat_with_percent(faves.new_images_count, faves.new_count)
      | were on new images.
    = increase_stats(faves.new_count, faves.overall_count)
    p
      ' Averages per image of
      span.stat>
        = number_with_delimiter(round(safe_div(faves.overall_count, images.overall_count)))
      ' overall and
      span.stat>
        = number_with_delimiter(round(safe_div(faves.new_images_count, images.new_count)))
      | this year.
    br
    p
      ' You received a total of
      span.stat>
        = number_with_delimiter(scores.new_count)
      ' score this year, of which
      => stat_with_percent(scores.new_images_count, scores.new_count)
      | were on new images.
    = increase_stats(scores.new_count, scores.overall_count)
    p
      ' Averages per image of
      span.stat>
        = number_with_delimiter(round(safe_div(scores.overall_count, images.overall_count)))
      ' overall and
      span.stat>
        = number_with_delimiter(round(safe_div(scores.new_images_count, images.new_count)))
      | this year.
    br
    p
      ' You received a total of
      span.stat>
        = number_with_delimiter(comments.new_count)
      ' comments this year, of which
      => stat_with_percent(comments.new_images_count, comments.new_count)
      | were on new images.
    = increase_stats(comments.new_count, comments.overall_count)
    p
      ' Averages per image of
      span.stat>
        = number_with_delimiter(round(safe_div(comments.overall_count, images.overall_count)))
      ' overall and
      span.stat>
        = number_with_delimiter(round(safe_div(comments.new_images_count, images.new_count)))
      | this year.
    .block
      .block__content.media-list.media-list--small
        = for {image, index} <- Enum.with_index(most_faved_images) do
          - style = if index == 0, do: "position: absolute;", else: ""
          .flex.flex--column style=style
            = render PhilomenaWeb.ImageView, "_image_box.html", image: image, size: :thumb_small, conn: @conn
            figcaption.center
              = "Most faved ##{index + 1}"
      .block__content.media-list.media-list--small
        = for {image, index} <- Enum.with_index(most_scored_images) do
          - style = if index == 0, do: "position: absolute;", else: ""
          .flex.flex--column style=style
            = render PhilomenaWeb.ImageView, "_image_box.html", image: image, size: :thumb_small, conn: @conn
            figcaption.center
              = "Most scored ##{index + 1}"
      .block__content.media-list.media-list--small
        = for {image, index} <- Enum.with_index(most_commented_on_images) do
          - style = if index == 0, do: "position: absolute;", else: ""
          .flex.flex--column style=style
            = render PhilomenaWeb.ImageView, "_image_box.html", image: image, size: :thumb_small, conn: @conn
            figcaption.center
              = "Most commented-on ##{index + 1}"