elixir:
  scope = scope(@conn)

h1
  ' Derped 2025 for
  = @user.name
p
  ' Accessible only to you. Share with others via
  = link "this special link", to: ~p"/profiles/#{@user}/derped?#{Keyword.put(scope, :token, @token)}"

h2 Global Statistics

h3 Users
p
  ' A total of
  span.stat>
    = number_with_delimiter(@global_overalls.new_user_count)
  ' new users were created this year.
= increase_stats(@global_overalls.new_user_count, @global_overalls.user_count)

h3 Images
p
  ' A total of
  span.stat>
    = number_with_delimiter(@global_images.count)
  ' new images were uploaded this year, by
  span.stat>
    = number_with_delimiter(@global_images.user_count)
  | users.

= increase_stats(@global_images.count, @global_overalls.image_count)

h3 Comments
p
  ' A total of
  span.stat>
    = number_with_delimiter(@global_comments.count)
  ' new comments were posted this year, by
  span.stat>
    = number_with_delimiter(@global_comments.user_count)
  ' users, across
  span.stat>
    = number_with_delimiter(@global_comments.image_count)
  ' images, of which
  => stat_with_percent(@global_comments.new_image_count, @global_comments.image_count)
  | were new this year.

= increase_stats(@global_comments.count, @global_overalls.comment_count)

h3 Topics
p
  ' A total of
  span.stat>
    = number_with_delimiter(@global_topics.count)
  ' new topics were created this year, by
  span.stat>
    = number_with_delimiter(@global_topics.user_count)
  | users.

= increase_stats(@global_topics.count, @global_overalls.topic_count)

h3 Posts
p
  ' A total of
  span.stat>
    = number_with_delimiter(@global_posts.count)
  ' new posts were created this year, by
  span.stat>
    = number_with_delimiter(@global_posts.user_count)
  ' users, across
  span.stat>
    = number_with_delimiter(@global_posts.topic_count)
  ' topics, of which
  => stat_with_percent(@global_posts.new_topic_count, @global_posts.topic_count)
  | were new this year.

= increase_stats(@global_posts.count, @global_overalls.post_count)

h3 Image Faves
p
  ' A total of
  span.stat>
    = number_with_delimiter(@global_faves.count)
  ' new image faves were added this year, by
  span.stat>
    = number_with_delimiter(@global_faves.user_count)
  ' users, across
  span.stat>
    = number_with_delimiter(@global_faves.image_count)
  ' images, of which
  => stat_with_percent(@global_faves.new_image_count, @global_faves.image_count)
  | were new this year.

= increase_stats(@global_faves.count, @global_overalls.image_fave_count)

h3 Image Votes
p
  ' A total of
  span.stat>
    = number_with_delimiter(@global_votes.total_count)
  ' new image votes were cast this year, of which
  span.stat>
    = Float.round(safe_div(@global_votes.up_count, @global_votes.total_count) * 100, 1)
    | %
  ' were upvotes, by
  span.stat>
    = number_with_delimiter(@global_votes.user_count)
  ' users, across
  span.stat>
    = number_with_delimiter(@global_votes.image_count)
  ' images, of which
  => stat_with_percent(@global_votes.new_image_count, @global_votes.image_count)
  | were new this year.

= increase_stats(@global_votes.total_count, @global_overalls.image_vote_count)

h3 Tag Changes
p
  ' A total of
  span.stat>
    = number_with_delimiter(@global_tag_changes.count)
  ' new tag changes were made this year, by
  span.stat>
    = number_with_delimiter(@global_tag_changes.user_count)
  ' users, affecting
  span.stat>
    = number_with_delimiter(@global_tag_changes.image_count)
  ' images, of which
  => stat_with_percent(@global_tag_changes.new_image_count, @global_tag_changes.image_count)
  | were new this year.

p
  ' Involving
  span.stat>
    = number_with_delimiter(@global_tag_change_tags.total_count)
  ' changes, of which
  => stat_with_percent(@global_tag_change_tags.added_count, @global_tag_change_tags.total_count)
  ' were additions and
  => stat_with_percent(@global_tag_change_tags.removed_count, @global_tag_change_tags.total_count)
  ' were removals, affecting
  span.stat>
    = number_with_delimiter(@global_tag_change_tags.tag_count)
  ' unique tags.

= increase_stats(@global_tag_changes.count, @global_overalls.tag_change_count)

h3 Source Changes
p
  ' A total of
  span.stat>
    = number_with_delimiter(@global_source_changes.count)
  ' new source changes were made this year, by
  span.stat>
    = number_with_delimiter(@global_source_changes.user_count)
  ' users, affecting
  span.stat>
    = number_with_delimiter(@global_source_changes.image_count)
  ' images, of which
  => stat_with_percent(@global_source_changes.new_image_count, @global_source_changes.image_count)
  | were new this year.

= increase_stats(@global_source_changes.count, @global_overalls.source_change_count)

h3 Reports
p
  ' A total of
  span.stat>
    = number_with_delimiter(@global_reports.count)
  ' new reports were filed this year, by
  span.stat>
    = number_with_delimiter(@global_reports.user_count)
  | users.

= increase_stats(@global_reports.count, @global_overalls.report_count)

h2 Global Leaderboards

h3 Top Tags Across New Images

h4 Ratings
table.table
  thead
    tr
      th Tag
      th Images
      th
  tbody
    = for %{tag: tag, count: count} <- @global_top_rating_taggings do
      tr
        td
          = render PhilomenaWeb.TagView, "_tag.html", tag: tag, conn: @conn
        td
          = number_with_delimiter(count)
        td
          = Float.round(safe_div(count, @global_images.count) * 100, 1)
          | %
h4 Content
table.table
  thead
    tr
      th Tag
      th Images
  tbody
    = for %{tag: tag, count: count} <- @global_top_content_official_taggings do
      tr
        td
          = render PhilomenaWeb.TagView, "_tag.html", tag: tag, conn: @conn
        td
          = number_with_delimiter(count)
h4 Characters
table.table
  thead
    tr
      th Tag
      th Images
  tbody
    = for %{tag: tag, count: count} <- @global_top_character_taggings do
      tr
        td
          = render PhilomenaWeb.TagView, "_tag.html", tag: tag, conn: @conn
        td
          = number_with_delimiter(count)

h3 Top Uploaders
table.table
  thead
    tr
      th User
      th Uploads
  tbody
    = for %{user: user, count: count} <- @global_top_uploaders do
      tr
        td
          = link user.name, to: ~p"/profiles/#{user.slug}"
        td
          = number_with_delimiter(count)

h3 Top Commenters
table.table
  thead
    tr
      th User
      th Comments
      th Across images
  tbody
    = for %{user: user, count: count, image_count: image_count} <- @global_top_commenters do
      tr
        td
          = link user.name, to: ~p"/profiles/#{user.slug}"
        td
          = number_with_delimiter(count)
        td
          = number_with_delimiter(image_count)

h3 Top Posters
table.table
  thead
    tr
      th User
      th Posts
      th Across topics
  tbody
    = for %{user: user, count: count, topic_count: topic_count} <- @global_top_posters do
      tr
        td
          = link user.name, to: ~p"/profiles/#{user.slug}"
        td
          = number_with_delimiter(count)
        td
          = number_with_delimiter(topic_count)

h3 Top Favers
table.table
  thead
    tr
      th User
      th Faves
  tbody
    = for %{user: user, count: count} <- @global_top_favers do
      tr
        td
          = link user.name, to: ~p"/profiles/#{user.slug}"
        td
          = number_with_delimiter(count)

h3 Top Voters
table.table
  thead
    tr
      th User
      th Votes
  tbody
    = for %{user: user, total_count: count} <- @global_top_voters do
      tr
        td
          = link user.name, to: ~p"/profiles/#{user.slug}"
        td
          = number_with_delimiter(count)

h3 Top Tag Changers
table.table
  thead
    tr
      th User
      th Tag Changes
      th Across images
  tbody
    = for %{user: user, count: count, image_count: image_count} <- @global_top_tag_changers do
      tr
        td
          = link user.name, to: ~p"/profiles/#{user.slug}"
        td
          = number_with_delimiter(count)
        td
          = number_with_delimiter(image_count)

h3 Top Source Changers
table.table
  thead
    tr
      th User
      th Source Changes
      th Across images
  tbody
    = for %{user: user, count: count, image_count: image_count} <- @global_top_source_changers do
      tr
        td
          = link user.name, to: ~p"/profiles/#{user.slug}"
        td
          = number_with_delimiter(count)
        td
          = number_with_delimiter(image_count)

h3 Top Added Tags
table.table
  thead
    tr
      th Tag
      th Times added
      th By users
  tbody
    = for %{tag: tag, count: count, user_count: user_count} <- @global_top_added_tags do
      tr
        td
          = render PhilomenaWeb.TagView, "_tag.html", tag: tag, conn: @conn
        td
          = number_with_delimiter(count)
        td
          = number_with_delimiter(user_count)

h3 Top Removed Tags
table.table
  thead
    tr
      th Tag
      th Times removed
      th By users
  tbody
    = for %{tag: tag, count: count, user_count: user_count} <- @global_top_removed_tags do
      tr
        td
          = render PhilomenaWeb.TagView, "_tag.html", tag: tag, conn: @conn
        td
          = number_with_delimiter(count)
        td
          = number_with_delimiter(user_count)
          
h3 Most Posted Forums
table.table
  thead
    tr
      th Forum
      th Posts
      th Across topics
      th By users
  tbody
    = for %{forum: forum, new_post_count: new_post_count, topic_count: topic_count, user_count: user_count} <- @global_most_posted_forums do
      tr
        td
          = link forum.name, to: ~p"/forums/#{forum}"
        td
          = number_with_delimiter(new_post_count)
        td
          = number_with_delimiter(topic_count)
        td
          = number_with_delimiter(user_count)

h3 Most Posted Topics
table.table
  thead
    tr
      th Topic
      th Posts
      th By users
  tbody
    = for %{topic: topic, new_post_count: new_post_count, user_count: user_count} <- @global_most_posted_topics do
      tr
        td
          = link topic.title, to: ~p"/forums/#{topic.forum}/topics/#{topic}"
        td
          = number_with_delimiter(new_post_count)
        td
          = number_with_delimiter(user_count)

h2 Your Statistics

h3 Time
= if safe_div(@user_visits.total, @user_visits.overall) >= 0.99 do
  p
    ' You visited Derpibooru a total of
    span.stat>
      = number_with_delimiter(@user_visits.total)
    ' times. This is approximately
    span.stat>
      = Float.round(@user_visits.total / 60.0, 2)
    | hours of browsing.
    = ranked(@user_visits)
  = if @user_visits.total >= 600 do
    p You joined us this year and have been here ever since! Welcome to the ride :)
- else
  p
    ' You visited Derpibooru a total of
    span.stat>
      = number_with_delimiter(@user_visits.overall)
    ' times overall. This is approximately
    span.stat>
      = Float.round(safe_div(@user_visits.overall, 60.0), 2)
    | hours of browsing.
  = if @user_visits.total > 10 do
    p
      ' This year alone, you visited at least
      span.stat>
        = number_with_delimiter(@user_visits.total)
      ' times, which is approximately
      span.stat>
        = Float.round(safe_div(@user_visits.total, 60.0), 2)
      | hours.
      = ranked(@user_visits)
    = if safe_div(@user_visits.total, @user_visits.overall) >= 0.1 and safe_div(@user_visits.total, @user_visits.overall) <= 0.9 do
      p
        ' Wow! That's
        span.stat>
          = Float.round(safe_div(@user_visits.total, @user_visits.overall) * 100, 2)
          | %
        | of all your time! The ride never ends :)
p We don't know how you spent your time or what you looked at, but we do know you were here!
br
i
  p
    b Some stats may be unreliable due to insufficient tracking.
  p Individual visits are not tracked but the total may be calculated and should be accurate.
  p Time spent is estimated from the number of visits, assuming each visit being one minute.
  p The number of visits this year is a lower bound and may not be entirely accurate.

h3 Images
p
  ' You uploaded a total of
  span.stat>
    = number_with_delimiter(@user_images.count)
  ' new images this year.
  = ranked(@user_images)

h3 Comments
p
  ' You posted a total of
  span.stat>
    = number_with_delimiter(@user_comments.count)
  ' new comments this year, across
  span.stat>
    = number_with_delimiter(@user_comments.image_count)
  ' images.
  = ranked(@user_comments)

h3 Image Faves
p
  ' You faved a total of
  span.stat>
    = number_with_delimiter(@user_faves.count)
  | images this year.
  = ranked(@user_faves)

h3 Image Votes
p
  ' You cast a total of
  span.stat>
    = number_with_delimiter(@user_votes.total_count)
  ' image votes this year, of which
  span.stat>
    = Float.round(safe_div(@user_votes.up_count, @user_votes.total_count) * 100, 1)
    | %
  ' were upvotes.
  = ranked(@user_votes)

h3 Topics
p
  ' You created a total of
  span.stat>
    = number_with_delimiter(@user_topics.count)
  | new topics this year.
  = ranked(@user_topics)

h3 Posts
p
  ' You created a total of
  span.stat>
    = number_with_delimiter(@user_posts.count)
  ' new posts this year, across
  span.stat>
    = number_with_delimiter(@user_posts.topic_count)
  | topics.
  = ranked(@user_posts)

h3 Tag Changes
p
  ' You made a total of
  span.stat>
    = number_with_delimiter(@user_tag_changes.count)
  ' tag changes this year, affecting
  span.stat>
    = number_with_delimiter(@user_tag_changes.image_count)
  | images.
  = ranked(@user_tag_changes)

h3 Source Changes
p
  ' You made a total of
  span.stat>
    = number_with_delimiter(@user_source_changes.count)
  ' source changes this year, affecting
  span.stat>
    = number_with_delimiter(@user_source_changes.image_count)
  | images.
  = ranked(@user_source_changes)

h3 Reports
p
  ' You filed a total of
  span.stat>
    = number_with_delimiter(@user_reports.count)
  ' reports this year. It took us on average
  span.stat>
    = Float.round(@user_reports.avg_time / 3600, 2)
  | hours to resolve them.
  = ranked(@user_reports)

h2 Personal Leaderboards

h3 Top Faved Characters
table.table
  thead
    tr
      th Tag
      th Faves
      th Rank among all users
  tbody
    = for %{tag: tag, faves: faves, rank: rank, ntile: ntile} <- @user_top_faved_character_tags do
      tr
        td
          = render PhilomenaWeb.TagView, "_tag.html", tag: tag, conn: @conn
        td
          = number_with_delimiter(faves)
        td
          = rank(rank, ntile)

h3 Top Faved Artists
table.table
  thead
    tr
      th Tag
      th Faves
      th Rank among all users
  tbody
    = for %{tag: tag, faves: faves, rank: rank, ntile: ntile} <- @user_top_faved_artist_tags do
      tr
        td
          = render PhilomenaWeb.TagView, "_tag.html", tag: tag, conn: @conn
        td
          = number_with_delimiter(faves)
        td
          = rank(rank, ntile)

h3 Top Faved OCs
table.table
  thead
    tr
      th Tag
      th Faves
      th Rank among all users
  tbody
    = for %{tag: tag, faves: faves, rank: rank, ntile: ntile} <- @user_top_faved_oc_tags do
      tr
        td
          = render PhilomenaWeb.TagView, "_tag.html", tag: tag, conn: @conn
        td
          = number_with_delimiter(faves)
        td
          = rank(rank, ntile)

h3 Top Faved Ships
table.table
  thead
    tr
      th Tag
      th Faves
      th Rank among all users
  tbody
    = for %{tag: tag, faves: faves, rank: rank, ntile: ntile} <- @user_top_faved_ship_tags do
      tr
        td
